diff --git a/images/base-win64/Dockerfile b/images/base-win64/Dockerfile
--- a/images/base-win64/Dockerfile
+++ b/images/base-win64/Dockerfile
@@ -41,2 +41,7 @@
     FFBUILD_CMAKE_TOOLCHAIN=/toolchain.cmake \
+    prefix=/ffbuild/prefix \
+    cross_prefix=${FFBUILD_TOOLCHAIN}- \
+    arch=x86_64 \
+    target_os=mingw32 \
+    pkg_config=pkg-config \
     PKG_CONFIG=pkg-config \
@@ -43,2 +48,9 @@
     PKG_CONFIG_LIBDIR=/opt/ffbuild/lib/pkgconfig:/opt/ffbuild/share/pkgconfig \
+    cc="${FFBUILD_TOOLCHAIN}-gcc" \
+    cxx="${FFBUILD_TOOLCHAIN}-g++" \
+    ld="${FFBUILD_TOOLCHAIN}-ld" \
+    ar="${FFBUILD_TOOLCHAIN}-gcc-ar" \
+    ranlib="${FFBUILD_TOOLCHAIN}-gcc-ranlib" \
+    nm="${FFBUILD_TOOLCHAIN}-gcc-nm" \
     CC="${FFBUILD_TOOLCHAIN}-gcc" \
diff --git a/build.sh b/build.sh
--- a/build.sh
+++ b/build.sh
@@ -35,5 +35,13 @@
-    ./configure --prefix=/ffbuild/prefix --pkg-config-flags="--static" \$FFBUILD_TARGET_FLAGS \$FF_CONFIGURE \
-        --extra-cflags="\$FF_CFLAGS" --extra-cxxflags="\$FF_CXXFLAGS" --extra-libs="\$FF_LIBS" \
-        --extra-ldflags="\$FF_LDFLAGS" --extra-ldexeflags="\$FF_LDEXEFLAGS" \
-        --cc="\$CC" --cxx="\$CXX" --ar="\$AR" --ranlib="\$RANLIB" --nm="\$NM" \
-        --extra-version="\$(date +%Y%m%d)" || { cat ffbuild/config.log; exit 1; }
+    if [[ '$TARGET' == win64 ]]; then
+        export CFLAGS="\$CFLAGS \$FF_CFLAGS"
+        export CXXFLAGS="\$CXXFLAGS \$FF_CXXFLAGS"
+        export LDFLAGS="\$LDFLAGS \$FF_LDFLAGS"
+        export LDEXEFLAGS="\$LDEXEFLAGS \$FF_LDEXEFLAGS"
+        export LIBS="\$LIBS \$FF_LIBS"
+        ./configure --pkg-config-flags="--static" \$FF_CONFIGURE || { cat ffbuild/config.log; exit 1; }
+    else
+        ./configure --prefix=/ffbuild/prefix --pkg-config-flags="--static" \$FFBUILD_TARGET_FLAGS \$FF_CONFIGURE \
+            --extra-cflags="\$FF_CFLAGS" --extra-cxxflags="\$FF_CXXFLAGS" --extra-libs="\$FF_LIBS" \
+            --extra-ldflags="\$FF_LDFLAGS" --extra-ldexeflags="\$FF_LDEXEFLAGS" \
+            --cc="\$CC" --cxx="\$CXX" --ar="\$AR" --ranlib="\$RANLIB" --nm="\$NM" \
+            --extra-version="\$(date +%Y%m%d)" || { cat ffbuild/config.log; exit 1; }
+    fi
